<Window x:Class="ZapretGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zapret DPI &amp; VPN Manager" Height="740" Width="1080"
        MinHeight="580" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D14" Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <!-- Windows 11 Fluent Dark Modern Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#0B0D14"/>
        <SolidColorBrush x:Key="BgHeader" Color="#10131B"/>
        <SolidColorBrush x:Key="BgCard" Color="#161922"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#1D212E"/>
        <SolidColorBrush x:Key="BgCardAlt" Color="#12151E"/>
        <SolidColorBrush x:Key="BorderCard" Color="#242938"/>
        <SolidColorBrush x:Key="BorderCardHover" Color="#373F54"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#1C212E"/>

        <SolidColorBrush x:Key="AccentBlurple" Color="#6366F1"/>
        <SolidColorBrush x:Key="AccentBlurpleHover" Color="#4F46E5"/>
        <SolidColorBrush x:Key="AccentBlurpleBg" Color="#1E1B4B"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentGreenHover" Color="#059669"/>
        <SolidColorBrush x:Key="AccentGreenBg" Color="#064E3B"/>
        <SolidColorBrush x:Key="AccentRed" Color="#F43F5E"/>
        <SolidColorBrush x:Key="AccentRedHover" Color="#E11D48"/>
        <SolidColorBrush x:Key="AccentRedBg" Color="#4C0519"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentYellowBg" Color="#451A03"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4"/>
        <SolidColorBrush x:Key="AccentCyanHover" Color="#0891B2"/>
        <SolidColorBrush x:Key="AccentCyanBg" Color="#083344"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="AccentPurpleHover" Color="#7C3AED"/>
        <SolidColorBrush x:Key="AccentPurpleBg" Color="#2E1065"/>

        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="InputBg" Color="#0E1118"/>
        <SolidColorBrush x:Key="InputBorder" Color="#242938"/>

        <!-- Primary Modern Button -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlurple}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#4F46E5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBlurpleHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button (Dark Acrylic) -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#1B1F2C"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCard}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252A3B"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderCardHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#151822"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green Emerald Button -->
        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
            <Setter Property="BorderBrush" Value="#059669"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentGreenHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#34D399"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red Rose Button -->
        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentRedHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#F87171"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyan Proxy GET Button -->
        <Style x:Key="CyanButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource AccentCyan}"/>
            <Setter Property="BorderBrush" Value="#0891B2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentCyanHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#22D3EE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Purple Import Button -->
        <Style x:Key="PurpleButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource AccentPurple}"/>
            <Setter Property="BorderBrush" Value="#7C3AED"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPurpleHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#A78BFA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Elevated Card Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCard}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Modern Fluent TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="#11141C"
                                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Margin="0,0,6,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="content" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter TargetName="border" Property="Background" Value="#1A1E2B"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderCardHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="border" Property="Background" Value="#222838"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBlurple}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Text Box Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBlurple}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderCardHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBlurple}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar -->
            <RowDefinition Height="*"/>    <!-- Main Content Tabs -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP BAR (Windows 11 Fluent Header) -->
        <Border Grid.Row="0" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource BorderCard}" BorderThickness="0,0,0,1" Padding="20,12" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo, Version & DPI Badges -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1C1836" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="8" Padding="7,5" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="18" Foreground="{StaticResource AccentYellow}" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ZAPRET DPI &amp; VPN" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource AccentBlurple}" CornerRadius="5" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.10.2" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <!-- DPI Scaled Indicator Badge -->
                            <Border Background="#1A1E2B" BorderBrush="#2D3448" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Режим масштабирования экрана PerMonitorV2">
                                <TextBlock x:Name="TxtDpiBadge" Text="🖥️ DPI: 100%" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            </Border>
                            <!-- Admin Status Badge -->
                            <Border x:Name="AdminBadgeBorder" Background="#450A0A" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="TxtAdminStatus" Text="⚠️ Без прав администратора" FontSize="10" FontWeight="Bold" Foreground="#FECACA"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtZapretRoot" Text="Папка: (определение...)" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Dual Live Status Indicators (Zapret + VPN) -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <!-- Zapret Status Pill -->
                    <Border x:Name="StatusPillBorder" Background="#161922" CornerRadius="16" Padding="12,5" BorderThickness="1" BorderBrush="{StaticResource BorderCard}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusIndicatorDot" Width="9" Height="9" Fill="{StaticResource AccentRed}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtGlobalStatus" Text="Zapret: Остановлен" FontWeight="SemiBold" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- VPN Status Pill -->
                    <Border x:Name="VpnStatusPillBorder" Background="#161922" CornerRadius="16" Padding="12,5" BorderThickness="1" BorderBrush="{StaticResource BorderCard}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="VpnStatusIndicatorDot" Width="9" Height="9" Fill="{StaticResource AccentRed}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtGlobalVpnStatus" Text="VPN: Отключен" FontWeight="SemiBold" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnElevateAdmin" Content="🛡️ Права админа" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnElevateAdmin_Click"/>
                    <Button x:Name="BtnQuickStart" Content="▶ Запустить Zapret" Style="{StaticResource GreenButton}" Margin="0,0,8,0" Click="BtnQuickStart_Click"/>
                    <Button x:Name="BtnQuickStop" Content="⏹ Остановить" Style="{StaticResource RedButton}" Margin="0,0,8,0" Click="BtnQuickStop_Click"/>
                    <Button x:Name="BtnBrowseFolder" Content="📁 Папка" Style="{StaticResource SecondaryButton}" Click="BtnBrowseFolder_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN NAVIGATION TABS -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="16,10,16,10">

            <!-- TAB 1: УПРАВЛЕНИЕ -->
            <TabItem Header="🚀  Управление">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,10,0,0">

                        <!-- STRATEGY SELECTOR CARD -->
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="Выбор стратегии обхода (BAT-пресета)" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Выберите подходящую конфигурацию winws под вашего интернет-провайдера." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbStrategies" Grid.Column="0" SelectionChanged="CmbStrategies_SelectionChanged" Height="36"/>
                                    <Button x:Name="BtnReloadStrategies" Grid.Column="1" Content="🔄 Обновить список" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BtnReloadStrategies_Click"/>
                                </Grid>

                                <!-- Arguments Preview and Edit -->
                                <Expander Grid.Row="2" Header="Настроить аргументы winws.exe для выбранной стратегии" Foreground="{StaticResource TextSecondary}" FontSize="12">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBox x:Name="TxtStrategyArgs" FontFamily="Consolas" FontSize="11" Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                            <Button x:Name="BtnResetArgs" Content="Сбросить к оригиналу BAT" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="8,4" Click="BtnResetArgs_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </Grid>
                        </Border>

                        <!-- SPLIT RUNNER MODES: STANDALONE vs SERVICE -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- CARD 1: STANDALONE -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,12">
                                <StackPanel>
                                    <TextBlock Text="Автономный запуск (Standalone)" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Запускает процесс winws.exe в фоне. Подходит для быстрого тестирования." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,12"/>

                                    <Border Background="{StaticResource InputBg}" CornerRadius="8" Padding="12" Margin="0,0,0,14" BorderBrush="{StaticResource BorderCard}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Статус процесса:" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock x:Name="TxtStandaloneStatus" Text="Остановлен" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentRed}" Margin="0,2,0,0"/>
                                                <TextBlock x:Name="TxtStandaloneDetails" Text="PID: — | Время работы: —" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <WrapPanel Margin="0,0,0,0">
                                        <Button x:Name="BtnStartStandalone" Content="▶ Запустить Standalone" Style="{StaticResource GreenButton}" Margin="0,0,8,8" Click="BtnStartStandalone_Click"/>
                                        <Button x:Name="BtnStopStandalone" Content="⏹ Остановить" Style="{StaticResource RedButton}" Margin="0,0,8,8" Click="BtnStopStandalone_Click"/>
                                        <Button x:Name="BtnRestartStandalone" Content="🔄 Перезапустить" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Click="BtnRestartStandalone_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- CARD 2: WINDOWS SERVICE -->
                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Служба Windows (Автозагрузка)" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Устанавливает zapret как системную службу. Работает автоматически при старте ПК." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,12"/>

                                    <Border Background="{StaticResource InputBg}" CornerRadius="8" Padding="12" Margin="0,0,0,14" BorderBrush="{StaticResource BorderCard}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Статус службы:" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock x:Name="TxtServiceStatus" Text="Не установлена" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                                <TextBlock x:Name="TxtServiceStrategy" Text="Стратегия: нет" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <WrapPanel Margin="0,0,0,0">
                                        <Button x:Name="BtnInstallService" Content="➕ Установить службу" Style="{StaticResource ModernButton}" Margin="0,0,8,8" Click="BtnInstallService_Click"/>
                                        <Button x:Name="BtnStartService" Content="▶ Старт" Style="{StaticResource GreenButton}" Margin="0,0,8,8" Click="BtnStartService_Click"/>
                                        <Button x:Name="BtnStopService" Content="⏹ Стоп" Style="{StaticResource RedButton}" Margin="0,0,8,8" Click="BtnStopService_Click"/>
                                        <Button x:Name="BtnRestartService" Content="🔄 Рестарт" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="BtnRestartService_Click"/>
                                        <Button x:Name="BtnRemoveAllServices" Content="🗑 Удалить службы" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Click="BtnRemoveAllServices_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: VPN И ПРОКСИ (BETA) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️  VPN и Прокси" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource AccentPurple}" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BETA" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Hero Status & Connect Card -->
                        <RowDefinition Height="Auto"/> <!-- HTTP GET Proxy Verification Card -->
                        <RowDefinition Height="Auto"/> <!-- Link & Subscription Input Card -->
                        <RowDefinition Height="*"/>    <!-- Server Node List Card -->
                    </Grid.RowDefinitions>

                    <!-- 1. HERO CONNECTION STATUS CARD -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Status Info -->
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1E1730" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,10,0">
                                        <TextBlock Text="🛡️ VPN" FontWeight="Bold" FontSize="11" Foreground="#DDD6FE"/>
                                    </Border>
                                    <TextBlock x:Name="TxtVpnConnectionStatus" Text="VPN: ОТКЛЮЧЕН" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentRed}" VerticalAlignment="Center"/>
                                    <Border x:Name="BadgeVpnBetaTag" Background="{StaticResource AccentPurple}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="BETA" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <TextBlock x:Name="TxtVpnSessionDuration" Text="Время работы: —" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock x:Name="TxtVpnActiveNodeName" Text="Выбранный узел: Не выбран" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,6,0,0"/>
                                <TextBlock x:Name="TxtVpnActiveNodeEndpoint" Text="Адрес: — | Протокол: —" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="ChkVpnSystemProxy" Content="Системный прокси Windows (WinINet)" Foreground="White" FontSize="11" IsChecked="True" ToolTip="Автоматически перенаправляет браузеры и системные программы через 127.0.0.1:10808" VerticalAlignment="Center"/>
                                    <Border Background="#12151F" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtVpnCoreStatus" Text="Ядро: sing-box (готово)" FontSize="10" Foreground="{StaticResource AccentGreen}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: Large Action Buttons -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="BtnVpnConnect" Content="▶ Подключиться" Style="{StaticResource GreenButton}" FontSize="13" Padding="18,9" Margin="0,0,8,0" Click="BtnVpnConnect_Click"/>
                                    <Button x:Name="BtnVpnDisconnect" Content="⏹ Отключить" Style="{StaticResource RedButton}" FontSize="13" Padding="18,9" Click="BtnVpnDisconnect_Click"/>
                                </StackPanel>
                                <Button x:Name="BtnVpnCopyConfig" Content="📋 Скопировать конфиг (JSON)" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="BtnVpnCopyConfig_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. HTTP GET PROXY VERIFICATION CARD ("проверка прокси через via proxy get") -->
                    <Border Grid.Row="1" Background="#111624" BorderBrush="#1E2B45" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🌐 Проверка доступности прокси через HTTP GET" FontSize="14" FontWeight="Bold" Foreground="#67E8F9"/>
                                        <Border Background="#083344" BorderBrush="#06B6D4" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="VIA PROXY GET" FontSize="9" FontWeight="Bold" Foreground="#22D3EE"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Выполняет честный HTTP GET запрос через туннель прокси, замеряет RTT-пинг и определяет внешний IP и геолокацию." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Trigger Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnVpnVerifyHttpGet" Content="🌐 Проверить соединение (HTTP GET)" Style="{StaticResource CyanButton}" Margin="0,0,8,0" Click="BtnVpnVerifyHttpGet_Click"/>
                                    <Button x:Name="BtnVpnVerifyAllHttpGet" Content="🌐 Проверить все (GET)" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnVpnVerifyAllHttpGet_Click"/>
                                    <Button x:Name="BtnVpnInstallCore" Content="⚙️ Ядро sing-box" Style="{StaticResource SecondaryButton}" Click="BtnVpnInstallCore_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- 4 Live Metric Tiles -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Metric 1: HTTP Latency -->
                                <Border Grid.Column="0" Background="#0C101A" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="⚡ HTTP GET Пинг" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="TxtVpnExitLatency" Text="—" FontSize="14" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Metric 2: Exit IP -->
                                <Border Grid.Column="1" Background="#0C101A" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="🌍 Выходной IP" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="TxtVpnExitIp" Text="—" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Metric 3: Location / Country -->
                                <Border Grid.Column="2" Background="#0C101A" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="📍 Страна и город" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="TxtVpnExitLocation" Text="—" FontSize="13" FontWeight="Bold" Foreground="#67E8F9" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Metric 4: ISP / ASN Org -->
                                <Border Grid.Column="3" Background="#0C101A" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="🏢 Провайдер / ASN" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="TxtVpnExitOrg" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 3. LINK & SUBSCRIPTION INPUT CARD -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="Вставить ссылку конфигурации или подписки" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Поддерживаются: vless://, vmess://, ss://, trojan://, wireguard://, hysteria2://, socks5://, clash yaml, а также https:// подписки." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <TextBox x:Name="TxtVpnLinkInput" Height="34" FontSize="12" VerticalContentAlignment="Center"
                                         ToolTip="Вставьте ссылку конфигурации или URL подписки (нажмите Enter для добавления)" Padding="10,5"
                                         KeyDown="TxtVpnLinkInput_KeyDown"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnVpnImportLink" Grid.Column="0" Content="📥 Добавить узел по ссылке" Style="{StaticResource PurpleButton}" Margin="0,0,8,0" Click="BtnVpnImportLink_Click"/>
                                <Button x:Name="BtnVpnFetchSubscription" Grid.Column="1" Content="🌐 Скачать подписку (URL)" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnVpnFetchSubscription_Click"/>

                                <Button x:Name="BtnVpnPasteClipboard" Grid.Column="3" Content="📋 Вставить из буфера" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnVpnPasteClipboard_Click"/>
                                <Button x:Name="BtnVpnClearInput" Grid.Column="4" Content="✕ Очистить" Style="{StaticResource SecondaryButton}" Click="BtnVpnClearInput_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 4. SERVER LIST CARD -->
                    <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="12" Margin="0" MinHeight="180">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header and Action Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Список доступных серверов" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                        <Border Background="#252A3B" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtVpnNodesCount" Text="0 узлов" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Дважды кликните по серверу для быстрого подключения." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnVpnTestAllPings" Content="⚡ Пинг (TCP)" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnVpnTestAllPings_Click"/>
                                    <Button x:Name="BtnVpnDeleteSelected" Content="🗑 Удалить выбранный" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnVpnDeleteSelected_Click"/>
                                    <Button x:Name="BtnVpnClearAll" Content="🧹 Очистить список" Style="{StaticResource SecondaryButton}" Click="BtnVpnClearAll_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Filter Box -->
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Поиск / Фильтр:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" FontSize="11"/>
                                <TextBox x:Name="TxtVpnFilter" Grid.Column="1" Padding="8,4" FontSize="12" ToolTip="Фильтрация по названию или адресу сервера" TextChanged="TxtVpnFilter_TextChanged"/>
                                <Button x:Name="BtnVpnClearFilter" Grid.Column="2" Content="✕" ToolTip="Сбросить фильтр" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="4,0,0,0" Click="BtnVpnClearFilter_Click"/>
                            </Grid>

                            <!-- Profiles ListView with HTTP GET Badge -->
                            <Border Grid.Row="2" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="8">
                                <ListView x:Name="ListVpnProfiles" Background="Transparent" BorderThickness="0" Foreground="White"
                                          SelectionChanged="ListVpnProfiles_SelectionChanged"
                                          MouseDoubleClick="ListVpnProfiles_MouseDoubleClick"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="Margin" Value="2,2"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="itemBorder" Property="Background" Value="#1E2332"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="itemBorder" Property="Background" Value="#252D42"/>
                                                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource AccentBlurple}"/>
                                                                <Setter TargetName="itemBorder" Property="BorderThickness" Value="1"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>

                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Protocol Badge -->
                                                <Border Grid.Column="0" Background="{Binding ProtocolBadgeBg}" CornerRadius="5" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProtocolBadge}" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                </Border>

                                                <!-- Node Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                                    <TextBlock Text="{Binding EndpointSummary}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                    <TextBlock Text="{Binding DetailsSummary}" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                </StackPanel>

                                                <!-- TCP Ping Badge -->
                                                <Border Grid.Column="2" Background="{Binding PingBadgeBg}" CornerRadius="5" Padding="7,3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding PingDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding PingBadgeFg}"/>
                                                </Border>

                                                <!-- HTTP GET Check Badge with Flag & Exit IP -->
                                                <Border Grid.Column="3" Background="{Binding HttpCheckBadgeBg}" CornerRadius="5" Padding="7,3" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="Результат проверки HTTP GET через прокси">
                                                    <TextBlock Text="{Binding HttpCheckDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding HttpCheckBadgeFg}" TextTrimming="CharacterEllipsis"/>
                                                </Border>

                                                <!-- Action Buttons Per Row -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="⚡ Пинг" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="7,3" Margin="0,0,4,0" Click="BtnVpnPingSingle_Click" Tag="{Binding}"/>
                                                    <Button Content="🌐 GET тест" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="7,3" Click="BtnVpnVerifySingleHttpGet_Click" Tag="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: НАСТРОЙКИ И ФИЛЬТРЫ -->
            <TabItem Header="⚙️  Фильтры и настройки">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">

                        <!-- GAME FILTER -->
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="🎮 Игровой фильтр (Game Filter)" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Включает фильтрацию игровых UDP/TCP портов (1024-65535). Влияет на голосовые чаты игр и Discord." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,10"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="RbGameFilterDisabled" Content="Отключен (12)" Foreground="White" Margin="0,0,16,0" Checked="GameFilter_Changed"/>
                                    <RadioButton x:Name="RbGameFilterAll" Content="TCP и UDP (1024-65535)" Foreground="White" Margin="0,0,16,0" Checked="GameFilter_Changed"/>
                                    <RadioButton x:Name="RbGameFilterTcp" Content="Только TCP" Foreground="White" Margin="0,0,16,0" Checked="GameFilter_Changed"/>
                                    <RadioButton x:Name="RbGameFilterUdp" Content="Только UDP" Foreground="White" Margin="0,0,16,0" Checked="GameFilter_Changed"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="💡 После изменения игрового фильтра перезапустите zapret (службу или standalone)." FontSize="11" Foreground="{StaticResource AccentYellow}"/>
                            </Grid>
                        </Border>

                        <!-- IPSET MODE -->
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="🌐 Режим фильтрации IPSet (ipset-all.txt)" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Определяет, какие IP-адреса трафика перехватываются zapret." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,10"/>
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="TxtIpsetStatus" Text="Текущий статус: Загружен (Loaded, 0 строк)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}"/>
                                        <TextBlock Text="• Loaded: активен полный список подсетей&#x0a;• None: фильтрация только тестового IP (обход выключен)&#x0a;• Any: фильтрация любого входящего/исходящего трафика" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnIpsetLoaded" Content="Loaded" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BtnIpsetLoaded_Click"/>
                                        <Button x:Name="BtnIpsetNone" Content="None" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BtnIpsetNone_Click"/>
                                        <Button x:Name="BtnIpsetAny" Content="Any" Style="{StaticResource SecondaryButton}" Click="BtnIpsetAny_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ACTIVE FAKES -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="🎭 Активные Fake-пакеты (Active Fakes)" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Выбор фейковых пакетов для обхода фильтров Discord UDP и игрового трафика." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,10"/>

                                <!-- Discord UDP Fake -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Discord UDP Fake:" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock x:Name="TxtCurrentDiscordFake" Text="активный: ..." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbDiscordFake" Grid.Column="1" Margin="8,0"/>
                                    <Button x:Name="BtnApplyDiscordFake" Grid.Column="2" Content="Заменить" Style="{StaticResource SecondaryButton}" Click="BtnApplyDiscordFake_Click"/>
                                </Grid>

                                <!-- Game UDP Fake -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Game UDP Fake:" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock x:Name="TxtCurrentGameFake" Text="активный: ..." FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbGameFake" Grid.Column="1" Margin="8,0"/>
                                    <Button x:Name="BtnApplyGameFake" Grid.Column="2" Content="Заменить" Style="{StaticResource SecondaryButton}" Click="BtnApplyGameFake_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- APP SETTINGS -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="🔧 Дополнительные параметры" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Параметры запуска приложения и системы." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,10"/>

                                <CheckBox x:Name="ChkAutoUpdate" Content="Автоматическая проверка обновлений репозитория Flowseal" Foreground="White" Margin="0,0,0,8" Click="ChkAutoUpdate_Click"/>
                                <CheckBox x:Name="ChkAutostart" Content="Запускать Zapret GUI вместе с Windows (в трей)" Foreground="White" Margin="0,0,0,8" Click="ChkAutostart_Click"/>
                                <CheckBox x:Name="ChkMinimizeToTray" Content="Сворачивать в системный трей при закрытии крестиком" Foreground="White" Margin="0,0,0,12" IsChecked="True"/>

                                <Button x:Name="BtnEnableTimestamps" Content="Включить TCP Timestamps (netsh interface tcp)" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="BtnEnableTimestamps_Click"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: СПИСКИ -->
            <TabItem Header="📝  Списки доменов и IP">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- List File Selector & Quick Add -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Файл списка:" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CmbLists" Grid.Column="1" SelectionChanged="CmbLists_SelectionChanged"/>
                            <Button x:Name="BtnOpenInNotepad" Grid.Column="2" Content="Открыть в Блокноте" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="BtnOpenInNotepad_Click"/>
                        </Grid>
                    </Border>

                    <!-- Quick Add and Search Bar -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtQuickAdd" Grid.Column="0" ToolTip="Введите domain.com или IP/CIDR" Padding="8,7"/>
                        <Button x:Name="BtnQuickAdd" Grid.Column="1" Content="➕ Добавить запись" Style="{StaticResource ModernButton}" Margin="8,0,14,0" Click="BtnQuickAdd_Click"/>

                        <!-- Search -->
                        <TextBlock Grid.Column="2" Text="Поиск:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtSearchList" Grid.Column="3" Padding="8,7" TextChanged="TxtSearchList_TextChanged"/>
                        <Button x:Name="BtnFindNext" Grid.Column="4" Content="🔍 Найти" ToolTip="Найти следующее совпадение в тексте" Style="{StaticResource SecondaryButton}" Margin="4,0,4,0" Padding="8,6" Click="BtnFindNext_Click"/>
                        <Button x:Name="BtnClearSearch" Grid.Column="5" Content="✕" ToolTip="Очистить поиск" Style="{StaticResource SecondaryButton}" Padding="8,6" Click="BtnClearSearch_Click"/>
                    </Grid>

                    <!-- Content Text Editor -->
                    <Border Grid.Row="2" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="8">
                        <TextBox x:Name="TxtListContent" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0"
                                 TextChanged="TxtListContent_TextChanged"/>
                    </Border>

                    <!-- Actions Bottom Bar -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtListStats" Grid.Column="0" Text="Всего строк: 0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                        <TextBlock x:Name="TxtSearchWarning" Grid.Column="1" Text="" Foreground="{StaticResource AccentYellow}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="16,0,8,0" Visibility="Collapsed"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="BtnReloadList" Content="🔄 Перезагрузить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnReloadList_Click"/>
                            <Button x:Name="BtnSaveList" Content="💾 Сохранить список" Style="{StaticResource GreenButton}" Click="BtnSaveList_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 5: ДИАГНОСТИКА -->
            <TabItem Header="🩺  Диагностика">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Диагностика системы и конфликтов" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Проверка WinDivert, сетевых служб, прокси, конфликтующих программ и кэша Discord." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnRunDiagnostics" Content="🔄 Проверить заново" Style="{StaticResource ModernButton}" Margin="0,0,8,0" Click="BtnRunDiagnostics_Click"/>
                                <Button x:Name="BtnFixConflicts" Content="🛠 Исправить конфликты" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnFixConflicts_Click"/>
                                <Button x:Name="BtnClearDiscordCache" Content="🧹 Очистить кэш Discord" Style="{StaticResource SecondaryButton}" Click="BtnClearDiscordCache_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Diagnostics List -->
                    <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ItemsDiagnostics">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource InputBg}" CornerRadius="6" Padding="12" Margin="0,0,0,8" BorderBrush="{StaticResource BorderCard}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding SeverityIcon}" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 6: ОБНОВЛЕНИЯ -->
            <TabItem Header="🔄  Обновления">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">

                        <!-- ZAPRET VERSION -->
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Версия Zapret" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="TxtZapretVersionStatus" Text="Текущая версия: v1.10.2" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnCheckVersion" Content="Проверить обновление" Style="{StaticResource ModernButton}" Margin="0,0,8,0" Click="BtnCheckVersion_Click"/>
                                    <Button x:Name="BtnOpenReleaseUrl" Content="Страница релизов GitHub" Style="{StaticResource SecondaryButton}" Click="BtnOpenReleaseUrl_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- IPSET LIST UPDATE -->
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Обновление списка подсетей IPSet" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Скачивает актуальный ipset-service.txt из официального репозитория Flowseal." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TxtIpsetUpdateStatus" Text="Готово к обновлению" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <Button x:Name="BtnUpdateIpset" Grid.Column="1" Content="Скачать и обновить IPSet" Style="{StaticResource GreenButton}" VerticalAlignment="Center" Click="BtnUpdateIpset_Click"/>
                            </Grid>
                        </Border>

                        <!-- HOSTS FILE UPDATE -->
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Файл hosts Windows" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Сверяет системный файл %SystemRoot%\System32\drivers\etc\hosts с репозиторием." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TxtHostsStatus" Text="Статус не проверен" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnCheckHosts" Content="Сверить hosts" Style="{StaticResource ModernButton}" Margin="0,0,8,0" Click="BtnCheckHosts_Click"/>
                                    <Button x:Name="BtnApplyHostsUpdate" Content="Обновить hosts" Style="{StaticResource GreenButton}" Margin="0,0,8,0" Click="BtnApplyHostsUpdate_Click"/>
                                    <Button x:Name="BtnOpenHostsInNotepad" Content="Блокнот" Style="{StaticResource SecondaryButton}" Click="BtnOpenHostsInNotepad_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 7: ТЕСТИРОВАНИЕ -->
            <TabItem Header="🧪  Тестирование">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Тестирование пресетов (test zapret.ps1)" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Автоматический прогон проверки доступности Discord, YouTube, Google и Cloudflare через targets.txt." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnRunTestsPs1" Content="▶ Запустить тесты в PowerShell" Style="{StaticResource GreenButton}" Margin="0,0,8,0" Click="BtnRunTestsPs1_Click"/>
                                <Button x:Name="BtnOpenTargetsTxt" Content="📄 Открыть targets.txt" Style="{StaticResource SecondaryButton}" Click="BtnOpenTargetsTxt_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Список целевых эндпоинтов (utils\targets.txt):" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                            <TextBox x:Name="TxtTargetsContent" Grid.Row="1" FontFamily="Consolas" FontSize="11" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            <Button x:Name="BtnSaveTargetsTxt" Grid.Row="2" Content="Сохранить изменения в targets.txt" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,8,0,0" Click="BtnSaveTargetsTxt_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 8: ЖУРНАЛ -->
            <TabItem Header="📜  Журнал (Лог)">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource InputBg}" BorderBrush="{StaticResource BorderCard}" BorderThickness="1" CornerRadius="8">
                        <TextBox x:Name="TxtConsoleLog" FontFamily="Consolas" FontSize="11" Background="Transparent" Foreground="#D1D5DB"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0" Padding="10"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="ChkAutoScroll" Grid.Column="0" Content="Автопрокрутка лога" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" IsChecked="True"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="BtnCopyLog" Content="📋 Скопировать" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnCopyLog_Click"/>
                            <Button x:Name="BtnClearLog" Content="🗑 Очистить журнал" Style="{StaticResource SecondaryButton}" Click="BtnClearLog_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource BorderCard}" BorderThickness="0,1,0,0" Padding="16,8" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatusBar" Grid.Column="0" Text="Готово" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Zapret GUI • Flowseal Edition • Fluent Dark" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
