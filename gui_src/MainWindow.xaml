<Window x:Class="ZapretGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZapretGUI"
        Title="ZapretVPN" Height="760" Width="1120"
        MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#0C0E15" Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <!-- Windows 11 Fluent Dark Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#0C0E15"/>
        <SolidColorBrush x:Key="BgHeader" Color="#131622"/>
        <SolidColorBrush x:Key="BgCard" Color="#171B28"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#1E2336"/>
        <SolidColorBrush x:Key="BgCardAlt" Color="#131622"/>
        <SolidColorBrush x:Key="BorderCard" Color="#252B3E"/>
        <SolidColorBrush x:Key="BorderCardHover" Color="#384360"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#1D2232"/>

        <!-- Accent Colors -->
        <SolidColorBrush x:Key="AccentBlurple" Color="#6366F1"/>
        <SolidColorBrush x:Key="AccentBlurpleHover" Color="#4F46E5"/>
        <SolidColorBrush x:Key="AccentBlurpleBg" Color="#1E1B4B"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentGreenHover" Color="#059669"/>
        <SolidColorBrush x:Key="AccentGreenBg" Color="#064E3B"/>
        <SolidColorBrush x:Key="AccentRed" Color="#F43F5E"/>
        <SolidColorBrush x:Key="AccentRedHover" Color="#E11D48"/>
        <SolidColorBrush x:Key="AccentRedBg" Color="#4C0519"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentYellowBg" Color="#451A03"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4"/>
        <SolidColorBrush x:Key="AccentCyanHover" Color="#0891B2"/>
        <SolidColorBrush x:Key="AccentCyanBg" Color="#083344"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="AccentPurpleHover" Color="#7C3AED"/>
        <SolidColorBrush x:Key="AccentPurpleBg" Color="#2E1065"/>

        <!-- Text & Input Colors -->
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="InputBg" Color="#10131E"/>
        <SolidColorBrush x:Key="InputBorder" Color="#252B3E"/>

        <!-- Fluent Minimalist ScrollBar Styles -->
        <Style x:Key="ScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="#2D344B" CornerRadius="4" Margin="2" SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#475273"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter Property="Background" Value="#6366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent" SnapsToDevicePixels="True">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent" SnapsToDevicePixels="True">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

